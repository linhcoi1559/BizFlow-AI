DATABASE_URL="file:./dev.db"
BIZFLOW_DEMO_MODE="true"

# Optional AI extraction
# GEMINI_API_KEY="your-gemini-api-key"

# Supabase Auth (set both in staging/production and remove BIZFLOW_DEMO_MODE)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# BIZFLOW_BOOTSTRAP_OWNER_EMAIL="owner@example.com"
# BIZFLOW_ORGANIZATION_NAME="Your Company"

# PostgreSQL/Supabase deployment
# Use the session pooler (port 5432) for the deployed application.
# Prefer the direct database connection for Prisma migrations.
# On IPv4-only networks, DIRECT_URL may use the same session pooler URI as DATABASE_URL.
# Never use the transaction pooler for Prisma migrations.
# DATABASE_URL="postgresql://postgres.project:password@pooler.supabase.com:5432/postgres?sslmode=require"
# DIRECT_URL="postgresql://postgres:password@db.project.supabase.co:5432/postgres?sslmode=require"

# AI reviews require a persistent server-only 32-byte encryption/signing key.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store it privately; never use NEXT_PUBLIC_ and never rotate without reconnecting ChatGPT.
# BIZFLOW_AI_SECRET="your-64-character-hex-secret"
# Enable ChatGPT plan usage only on the personal local installation.
# BIZFLOW_CHATGPT_LOCAL="true"
